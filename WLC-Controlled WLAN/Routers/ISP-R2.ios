enable
configure terminal

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! Basic Config
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
hostname ISP-R2
banner motd # Fly free. Rise above. #

line console 0
exec-timeout 0 0
logging synchronous
login local

line vty 0 4
logging synchronous
transport input ssh
login local

no ip domain lookup



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! Local Account Config
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
username admin privilege 15 password WithLove
aaa authentication login default local



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! SSH Config
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
ip domain name cns.org
ip ssh version 2
crypto key generate rsa general-keys modulus 4096



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! Interface Config
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
interface Serial0/0/0
clock rate 38400
ip address 10.3.0.2 255.255.255.252
no shutdown



!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! OSPF Config
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
router ospf 10
network 10.3.0.0 0.0.0.3 area 0
network 8.0.0.0 0.255.255.255 area 0
passive-interface GigabitEthernet0/0

interface GigabitEthernet0/0
ip address 8.255.255.254 255.0.0.0
no shutdown

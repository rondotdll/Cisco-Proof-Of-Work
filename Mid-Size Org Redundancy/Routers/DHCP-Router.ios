!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! DHCP-Router Config
enable
configure terminal

hostname DHCP-Router

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! BASIC CONFIG
!!!!!!!!!!!!!!!!
line console 0
logging synchronous
exec-timeout 5 0
login local
no ip domain lookup

username admin privilege 15 secret cisco123
enable secret class456

banner motd # Unauthorized Access is Strictly Prohibited! #

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! SSH CONFIG
!!!!!!!!!!!!!!!!
ip domain-name ihatepackettracer.com
crypto key generate rsa general-keys modulus 2048

line vty 0 4
logging synchronous
exec-timeout 5 0
transport input ssh
login local

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! INTERFACE CONFIG
!!!!!!!!!!!!!!!!
interface Serial0/0/0
description Link to R00
ip address 172.16.1.1 255.255.255.255
no shutdown

interface Serial0/0/1
description Link to R01
ip address 172.16.1.5 255.255.255.252
no shutdown

interface Serial0/2/0
description Link to R20
ip address 172.16.1.9 255.255.255.252
no shutdown

interface Serial0/2/1
description Link to R21
ip address 172.16.1.13 255.255.255.252
no shutdown

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! OSPF CONFIG
!!!!!!!!!!!!!!!!
router ospf 67
network 172.16.1.0 0.0.0.3 area 0
network 172.16.1.4 0.0.0.3 area 0
network 172.16.1.8 0.0.0.3 area 0
network 172.16.1.12 0.0.0.3 area 0

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! DHCP CONFIG
!!!!!!!!!!!!!!!!
ip dhcp excluded-address 192.168.10.1 192.168.10.10
ip dhcp excluded-address 192.168.20.1 192.168.20.10
ip dhcp excluded-address 192.168.30.1 192.168.30.10
ip dhcp excluded-address 192.168.40.1 192.168.40.10

ip dhcp excluded-address 192.168.100.1 192.168.100.10
ip dhcp excluded-address 192.168.101.1 192.168.101.10
ip dhcp excluded-address 192.168.110.1 192.168.110.10
ip dhcp excluded-address 192.168.111.1 192.168.111.10

ip dhcp pool VLAN10
network 192.168.10.0 255.255.255.0
default-router 192.168.10.1

ip dhcp pool VLAN20
network 192.168.20.0 255.255.255.0
default-router 192.168.20.1

ip dhcp pool VLAN30
network 192.168.30.0 255.255.255.0
default-router 192.168.30.1

ip dhcp pool VLAN40
network 192.168.40.0 255.255.255.0
default-router 192.168.40.1

ip dhcp pool VLAN100
network 192.168.100.0 255.255.255.0
default-router 192.168.100.1

ip dhcp pool VLAN101
network 192.168.101.0 255.255.255.0
default-router 192.168.101.1

ip dhcp pool VLAN110
network 192.168.110.0 255.255.255.0
default-router 192.168.110.1

ip dhcp pool VLAN111
network 192.168.111.0 255.255.255.0
default-router 192.168.111.1

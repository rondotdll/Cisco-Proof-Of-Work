!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! R01 Config
enable
configure terminal

hostname R01

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! BASIC CONFIG
!!!!!!!!!!!!!!!!
line console 0
logging synchronous
exec-timeout 5 0
login local
no ip domain lookup

username admin privilege 15 secret cisco123
enable secret class456

banner motd # Unauthorized Access is Strictly Prohibited! #

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! SSH CONFIG
!!!!!!!!!!!!!!!!
ip domain-name ihatepackettracer.com
crypto key generate rsa general-keys modulus 2048

line vty 0 4
logging synchronous
exec-timeout 5 0
transport input ssh
login local

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! INTERFACE CONFIG
!!!!!!!!!!!!!!!!
interface FastEthernet0/0
description Link to DSW01
ip address 172.16.1.33 255.255.255.252
no shutdown

interface FastEthernet0/1
description Link to DSW20
ip address 172.16.1.41 255.255.255.252
no shutdown

interface Serial0/1/0
description Link to R20
ip address 172.16.1.21 255.255.255.252
no shutdown

interface Serial0/0/0
description Link to DHCP-Router
ip address 172.16.1.6 255.255.255.252
no shutdown

interface Serial0/1/1
description Link to R00
ip address 172.16.1.18 255.255.255.252
no shutdown

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! OSPF CONFIG
!!!!!!!!!!!!!!!!
router ospf 67
! serial links
network 172.16.1.8 0.0.0.3 area 0
network 172.16.1.20 0.0.0.3 area 0
network 172.16.1.28 0.0.0.3 area 0

! copper links
network 172.16.1.32 0.0.0.3 area 1
network 172.16.1.40 0.0.0.3 area 1

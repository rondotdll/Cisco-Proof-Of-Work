!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! R21 Config
enable
configure terminal

hostname R21

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! BASIC CONFIG
!!!!!!!!!!!!!!!!
line console 0
logging synchronous
exec-timeout 5 0
login local
no ip domain lookup

username admin privilege 15 secret cisco123
enable secret class456

banner motd # Unauthorized Access is Strictly Prohibited! #

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! SSH CONFIG
!!!!!!!!!!!!!!!!
ip domain-name ihatepackettracer.com
crypto key generate rsa general-keys modulus 2048

line vty 0 4
logging synchronous
exec-timeout 5 0
transport input ssh
login local

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! INTERFACE CONFIG
!!!!!!!!!!!!!!!!
interface FastEthernet0/0
description Link to DSW21
ip address 172.16.1.61 255.255.255.252
no shutdown

interface FastEthernet0/1
description Link to DSW00
ip address 172.16.1.53 255.255.255.252
no shutdown

interface Serial0/1/0
description Link to R00
ip address 172.16.1.29 255.255.255.252
no shutdown

interface Serial0/0/0
description Link to DHCP-Router
ip address 172.16.1.14 255.255.255.252
no shutdown

interface Serial0/1/1
description Link to R20
ip address 172.16.1.26 255.255.255.252
no shutdown

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! OSPF CONFIG
!!!!!!!!!!!!!!!!
router ospf 67
! serial links
network 172.16.1.12 0.0.0.3 area 0
network 172.16.1.24 0.0.0.3 area 0
network 172.16.1.28 0.0.0.3 area 0

! copper links
network 172.16.1.52 0.0.0.3 area 2
network 172.16.1.60 0.0.0.3 area 2

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! DSW20 Config
enable
configure terminal

hostname DSW20
ip routing

!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! BASIC CONFIG
!!!!!!!!!!!!!!
line console 0
logging synchronous
exec-timeout 5 0
login local
no ip domain lookup

username admin privilege 15 secret cisco123
enable secret class456

banner motd # Unauthorized Access is Strictly Prohibited! #

!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! SSH CONFIG
!!!!!!!!!!!!!!
ip domain-name ihatepackettracer.com
crypto key generate rsa general-keys modulus 2048

line vty 0 4
logging synchronous
exec-timeout 5 0
transport input ssh
login local

!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! VLAN CONFIG
!!!!!!!!!!!!!!
vlan 10
name Reception

vlan 20
name Sales

vlan 30
name Accounting

vlan 40
name IT

vlan 99
name Native

vlan 999
name TaxTime

!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! SPANNING-TREE CONFIG
!!!!!!!!!!!!!!
spanning-tree mode rapid-pvst
spanning-tree vlan 10,20 priority 20480
spanning-tree vlan 30,40 priority 24576

!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! INTERFACE CONFIG
!!!!!!!!!!!!!!
interface FastEthernet0/22
description Link to ASW01
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk native vlan 99
switchport trunk allowed vlan 10,20,30,40
no shutdown

interface FastEthernet0/24
description Link to ASW20
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk native vlan 99
switchport trunk allowed vlan 10,20,30,40
no shutdown

interface FastEthernet0/23
description Link to DSW01
no switchport
ip address 172.16.1.66 255.255.255.252
no shutdown

interface FastEthernet0/1
description Link to R20
no switchport
ip address 172.16.1.46 255.255.255.252
no shutdown

interface FastEthernet0/2
description Link to R01
no switchport
ip address 172.16.1.42 255.255.255.252
no shutdown

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! HSRP CONFIG
!!!!!!!!!!!!!!!!
interface vlan 10
ip address 192.168.10.2 255.255.255.0
ip helper-address 172.16.1.9
standby 20 ip 192.168.10.1
standby 20 priority 110
standby 20 preempt
no shutdown

interface vlan 20
ip address 192.168.20.2 255.255.255.0
ip helper-address 172.16.1.9
standby 20 ip 192.168.20.1
standby 20 priority 110
standby 20 preempt
no shutdown

interface vlan 30
ip address 192.168.30.3 255.255.255.0
ip helper-address 172.16.1.9
standby 30 ip 192.168.30.1
standby 30 priority 100
standby 30 preempt
no shutdown

interface vlan 40
ip address 192.168.40.3 255.255.255.0
ip helper-address 172.16.1.9
standby 40 ip 192.168.40.1
standby 40 priority 100
standby 40 preempt
no shutdown

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! OSPF CONFIG
!!!!!!!!!!!!!!!!
router ospf 67
network 192.168.10.0 0.0.0.255 area 1
network 192.168.20.0 0.0.0.255 area 1
network 192.168.30.0 0.0.0.255 area 1
network 192.168.40.0 0.0.0.255 area 1

network 172.16.1.40 0.0.0.3 area 1
network 172.16.1.44 0.0.0.3 area 1
network 172.16.1.64 0.0.0.3 area 1

passive-interface vlan 10
passive-interface vlan 20
passive-interface vlan 30
passive-interface vlan 40

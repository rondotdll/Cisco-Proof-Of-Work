!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! ASW00 Config
enable
configure terminal

hostname ASW00

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! BASIC CONFIG
!!!!!!!!!!!!!!!!
line console 0
logging synchronous
exec-timeout 5 0
login local
no ip domain lookup

username admin secret cisco123 
enable secret class456

banner motd # Unauthorized Access is Strictly Prohibited! #

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! VLAN CONFIG
!!!!!!!!!!!!!!!!
vlan 100
name Warehouse

vlan 111
name Office

vlan 101
name WarehouseServer

vlan 110
name OfficeServer

vlan 99
name Native

vlan 999
name TaxTime

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! SPANNING-TREE CONFIG
!!!!!!!!!!!!!!!!
spanning-tree mode rapid-pvst
spanning-tree vlan 101,110 priority 28672
spanning-tree vlan 100,111 priority 32768

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! INTERFACE CONFIG
!!!!!!!!!!!!!!!!
interface FastEthernet0/1
description Link to Server 0
switchport mode access
switchport access vlan 101
spanning-tree portfast
spanning-tree bpduguard enable
no shutdown

interface FastEthernet0/13
description Link to Server 1
switchport mode access
switchport access vlan 110
spanning-tree portfast
spanning-tree bpduguard enable
no shutdown

interface range FastEthernet0/22-24
description Trunk Link
switchport mode trunk
switchport trunk native vlan 99
switchport trunk allowed vlan 100,101,110,111
no shutdown

interface range FastEthernet0/2-12,FastEthernet0/14-21
switchport mode access
switchport access vlan 999
spanning-tree portfast
spanning-tree bpduguard enable

! schizo security configuration:
switchport protected
switchport port-security
switchport port-security mac-address 0.0.0
switchport port-security maximum 1
switchport port-security violation shutdown
shutdown
